# Скопируйте в backend/.env и заполните

# Ключ OpenAI — нужен только для облачного ASR (provider=openai)
OPENAI_API_KEY=sk-...

# ASR по умолчанию: local (faster-whisper, бесплатно, офлайн) или openai (облако)
ASR_PROVIDER=local

# Облачная модель: gpt-4o-mini-transcribe (рекомендовано, июль 2026) или whisper-1 (legacy, но умеет segments/srt)
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe

# Локальная модель faster-whisper: tiny / base / small / medium / large-v3
LOCAL_ASR_MODEL=small
LOCAL_ASR_DEVICE=auto
LOCAL_ASR_COMPUTE=int8

# Язык распознавания (пусто = автоопределение)
ASR_LANGUAGE=ru
