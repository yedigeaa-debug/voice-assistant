# --- LLM (Part 3 agent brain) ---
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# --- Part 1: ASR (Dana) ---
# Provider: local (faster-whisper, offline, free) or openai (cloud)
ASR_PROVIDER=local
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe   # cloud; or whisper-1 (legacy, has segments)
LOCAL_ASR_MODEL=small                      # tiny/base/small/medium/large-v3
LOCAL_ASR_DEVICE=auto                      # auto/cpu/cuda
LOCAL_ASR_COMPUTE=int8                     # int8 on CPU, float16 on GPU
ASR_LANGUAGE=ru                            # empty = auto-detect

# --- Part 2: TTS (teammate config; example for ElevenLabs) ---
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=your-voice-id

# --- MCP Playwright ---
# Command used to launch the Playwright MCP server (runs headless Chromium).
MCP_PLAYWRIGHT_CMD=npx
MCP_PLAYWRIGHT_ARGS=-y,@playwright/mcp@latest,--headless

# --- Server ---
CORS_ORIGINS=*
